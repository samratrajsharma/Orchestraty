# Database (use "postgres" for Docker, "localhost" for local dev outside Docker)
DATABASE_URL=postgresql+asyncpg://orchestraty:orchestraty_dev@postgres:5432/orchestraty

# MinIO / S3-compatible object storage (use "minio" for Docker, "localhost" for local dev)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=orchestraty
MINIO_USE_SSL=false

# Redis
# Redis (use "redis" for Docker, "localhost" for local dev)
REDIS_URL=redis://redis:6379/0

# Auth / Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Qdrant (Vector DB — use "qdrant" for Docker, "localhost" for local dev)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=orchestraty_embeddings

# Celery (uses Redis DB 1 & 2, separate from app cache on DB 0)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Embedding Model (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Initial Superuser (auto-created on first startup)
ADMIN_EMAIL=admin@orchestraty.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Admin

# Runtime
ENVIRONMENT=development

# LLM Providers
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3

# Image Pipeline
IMAGE_THUMBNAIL_SIZE=256
IMAGE_MAX_UPLOAD_MB=50
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
QDRANT_IMAGE_COLLECTION=orchestraty_image_embeddings
