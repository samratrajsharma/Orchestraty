/* ═══════════════════════════════════════════════════════════════════
   Know Your Projects — Dark Theme (Default)
   Color Palette:
     Background:  #0d1117  (GitHub dark)
     Surface:     #161b22
     Border:      #30363d
     Accent:      #7c3aed  (Vibrant purple)
     Text:        #e6edf3
     Muted:       #8b949e
═══════════════════════════════════════════════════════════════════ */

/* ── Global ─────────────────────────────────────────────────────── */
QMainWindow, QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Segoe UI", "Inter", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow::separator {
    background: #30363d;
    width: 1px;
    height: 1px;
}

/* ── Menu Bar ────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #161b22;
    color: #e6edf3;
    border-bottom: 1px solid #30363d;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #21262d;
    color: #a78bfa;
}

QMenu {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #21262d;
    color: #a78bfa;
}

QMenu::separator {
    background: #30363d;
    height: 1px;
    margin: 4px 8px;
}

/* ── Toolbar ─────────────────────────────────────────────────────── */
QToolBar {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
    padding: 4px 8px;
    spacing: 4px;
}

QToolBar::separator {
    background: #30363d;
    width: 1px;
    margin: 4px 4px;
}

/* ── Toolbar Buttons ─────────────────────────────────────────────── */
QPushButton#toolbarBtn {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 9pt;
}

QPushButton#toolbarBtn:hover {
    background-color: #2d333b;
    border-color: #7c3aed;
    color: #a78bfa;
}

QPushButton#toolbarIconBtn {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    font-size: 14pt;
}

QPushButton#toolbarIconBtn:hover {
    background-color: #2d333b;
    border-color: #7c3aed;
}

/* Project name label in toolbar */
QLabel#projectNameLabel {
    color: #a78bfa;
    font-size: 11pt;
    font-weight: bold;
    padding: 0 12px;
}

/* ── Status Bar ──────────────────────────────────────────────────── */
QStatusBar {
    background-color: #161b22;
    color: #8b949e;
    border-top: 1px solid #30363d;
    font-size: 9pt;
}

QStatusBar QLabel {
    color: #8b949e;
    font-size: 9pt;
}

/* ── Progress Bar ────────────────────────────────────────────────── */
QProgressBar {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 4px;
    text-align: center;
    color: #e6edf3;
    font-size: 8pt;
    height: 14px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7c3aed, stop:1 #a855f7);
    border-radius: 3px;
}

/* ── Splitter ────────────────────────────────────────────────────── */
QSplitter#outerSplitter::handle, QSplitter#centerSplitter::handle {
    background-color: #30363d;
}

QSplitter#outerSplitter::handle:hover, QSplitter#centerSplitter::handle:hover {
    background-color: #7c3aed;
}

/* ── Tab Widget ──────────────────────────────────────────────────── */
QTabWidget#leftTabs::pane {
    border: none;
    background: #0d1117;
}

QTabWidget#leftTabs > QTabBar::tab {
    background: #161b22;
    color: #8b949e;
    border: none;
    padding: 8px 16px;
    font-size: 9pt;
}

QTabWidget#leftTabs > QTabBar::tab:selected {
    background: #0d1117;
    color: #a78bfa;
    border-bottom: 2px solid #7c3aed;
}

QTabWidget#leftTabs > QTabBar::tab:hover {
    color: #e6edf3;
    background: #21262d;
}

QTabWidget#functionTabs::pane {
    border: 1px solid #30363d;
    background: #0d1117;
}

QTabWidget#functionTabs > QTabBar::tab {
    background: #161b22;
    color: #8b949e;
    border: 1px solid #30363d;
    padding: 6px 16px;
    font-size: 9pt;
}

QTabWidget#functionTabs > QTabBar::tab:selected {
    background: #0d1117;
    color: #a78bfa;
    border-bottom: 2px solid #7c3aed;
}

/* ── Tree Panel ──────────────────────────────────────────────────── */
QFrame#treePanelHeader {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
}

QFrame#searchFrame {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
}

QLineEdit#searchBox {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 9pt;
}

QLineEdit#searchBox:focus {
    border-color: #7c3aed;
}

QTreeWidget#fileTree {
    background-color: #0d1117;
    color: #e6edf3;
    border: none;
    font-size: 9pt;
    alternate-background-color: #0d1117;
    outline: none;
    show-decoration-selected: 1;
}

QTreeWidget#fileTree::item {
    padding: 3px 4px;
    border-radius: 4px;
}

QTreeWidget#fileTree::item:hover {
    background-color: #161b22;
}

QTreeWidget#fileTree::item:selected {
    background-color: #1a2a4a;
    color: #a78bfa;
}

QScrollBar:vertical {
    background: #0d1117;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #7c3aed;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #0d1117;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #7c3aed;
}

/* ── File Info Bar ───────────────────────────────────────────────── */
QFrame#fileInfoBar {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
}

QLabel#fileLabel {
    color: #e6edf3;
}

QFrame#hintBar {
    background-color: #0d1117;
    border-top: 1px solid #21262d;
}

/* ── Code Editor ─────────────────────────────────────────────────── */
QPlainTextEdit#functionCode {
    background-color: #0d1117;
    color: #e6edf3;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 10pt;
    selection-background-color: #1f3a5f;
}

/* ── Explanation Panel ───────────────────────────────────────────── */
QFrame#explanationHeader {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
}

QLabel#breadcrumbLabel {
    color: #e6edf3;
}

QPushButton#copyBtn {
    background-color: #21262d;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 4px;
    font-size: 9pt;
}

QPushButton#copyBtn:hover {
    background-color: #2d333b;
    color: #e6edf3;
    border-color: #7c3aed;
}

QTextEdit#explanationText {
    background-color: #0d1117;
    color: #e6edf3;
    border: none;
    font-size: 10pt;
    selection-background-color: #1f3a5f;
    padding: 12px;
}

/* ── Graph Header ────────────────────────────────────────────────── */
QFrame#graphHeader {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
}

QComboBox#scopeCombo {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 9pt;
}

QComboBox#scopeCombo:hover {
    border-color: #7c3aed;
}

QComboBox#scopeCombo::drop-down {
    border: none;
    width: 16px;
}

QPushButton#graphHeader QPushButton {
    background-color: #21262d;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 4px;
}

/* ── Stats Bar ───────────────────────────────────────────────────── */
QFrame#statsBar {
    background-color: #161b22;
    border-top: 1px solid #30363d;
}

/* ── Dividers ────────────────────────────────────────────────────── */
QFrame#divider {
    color: #30363d;
    background-color: #30363d;
    max-height: 1px;
}

/* ── Welcome Screen ──────────────────────────────────────────────── */
QFrame#heroSection {
    background: transparent;
}

QLabel#appName {
    color: #e6edf3;
    font-size: 32pt;
    font-weight: bold;
}

QFrame#dropZone {
    background-color: #161b22;
    border: 2px dashed #30363d;
    border-radius: 12px;
}

QFrame#dropZone:hover {
    border-color: #7c3aed;
    background-color: #13111f;
}

QLabel#dropTitle {
    color: #e6edf3;
}

QFrame#githubFrame {
    background: transparent;
}

QLineEdit#githubInput {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 10pt;
}

QLineEdit#githubInput:focus {
    border-color: #7c3aed;
    background-color: #13111f;
}

QPushButton#loadGithubBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7c3aed, stop:1 #a855f7);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 10pt;
    font-weight: bold;
}

QPushButton#loadGithubBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6d28d9, stop:1 #9333ea);
}

QFrame#featureCard {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
}

QFrame#featureCard:hover {
    border-color: #7c3aed;
    background-color: #13111f;
}

/* ── Function Popup ──────────────────────────────────────────────── */
QFrame#popupTitleBar {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
}

QLabel#popupFuncName {
    color: #a78bfa;
}

QPushButton#graphBtn {
    background-color: #21262d;
    color: #a78bfa;
    border: 1px solid #7c3aed;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 9pt;
}

QPushButton#graphBtn:hover {
    background-color: #1a1060;
    border-color: #a78bfa;
}

QListWidget#callsList {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    font-size: 9pt;
    padding: 4px;
}

QListWidget#callsList::item:hover {
    background-color: #21262d;
}

QListWidget#callsList::item:selected {
    background-color: #1a2a4a;
    color: #a78bfa;
}

/* ── Settings Dialog ─────────────────────────────────────────────── */
QDialog {
    background-color: #161b22;
    color: #e6edf3;
}

QGroupBox {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    font-size: 9pt;
    font-weight: bold;
    color: #a78bfa;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #a78bfa;
}

QFormLayout QLabel {
    color: #8b949e;
    font-size: 9pt;
}

QLineEdit {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 9pt;
}

QLineEdit:focus {
    border-color: #7c3aed;
}

QComboBox {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 9pt;
}

QComboBox:hover {
    border-color: #7c3aed;
}

QComboBox QAbstractItemView {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    selection-background-color: #1a2a4a;
}

QSpinBox {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 9pt;
}

QCheckBox {
    color: #e6edf3;
    font-size: 9pt;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #30363d;
    border-radius: 3px;
    background: #21262d;
}

QCheckBox::indicator:checked {
    background: #7c3aed;
    border-color: #7c3aed;
}

/* Standard Buttons */
QPushButton {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 9pt;
}

QPushButton:hover {
    background-color: #2d333b;
    border-color: #7c3aed;
    color: #a78bfa;
}

QPushButton:pressed {
    background-color: #161b22;
}

/* Dialog buttons */
QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* Input dialog */
QInputDialog {
    background-color: #161b22;
    color: #e6edf3;
}

/* Message Box */
QMessageBox {
    background-color: #161b22;
    color: #e6edf3;
}

/* Tool Tips */
QToolTip {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #7c3aed;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 9pt;
}
