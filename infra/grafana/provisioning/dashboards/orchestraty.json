{
  "uid": "orchestraty",
  "title": "Orchestraty Overview",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Agents online",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "orchestraty_agents_online", "refId": "A"}]
    },
    {
      "id": 2, "type": "stat", "title": "Predictions served",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "model_server_predictions_total", "refId": "A"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "Workflows by status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "orchestraty_workflows", "legendFormat": "{{status}}", "refId": "A"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "Tasks by status",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "orchestraty_tasks", "legendFormat": "{{status}}", "refId": "A"}]
    }
  ]
}
