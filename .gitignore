# ───────────── Dependencies ─────────────
node_modules/
.venv/
venv/
env/

# ───────────── Python ─────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ───────────── JS / build output ─────────────
dist/
dist-*/
build/
.vite/
*.tsbuildinfo
.deps-installed

# ───────────── App runtime state & caches ─────────────
.cache/
.orch_cache/
*.log

# ───────────── Secrets & local env ─────────────
.env
.env.*
!.env.example

# ───────────── Docs — kept local, not committed (per request) ─────────────
# Except the architecture decision records in docs/decisions/, which are tracked.
# "/docs/*" (not "/docs/") so git still looks inside docs/ and the "!" rule can apply.
/docs/*
!/docs/decisions/
/*.docx
/*.pptx
/*.xlsx

# ───────────── Spike outputs (never committed) ─────────────
# Spikes write results to out/ or data/ folders, or outside the repository.
spikes/**/out/
spikes/**/data/
# Scanner result files, wherever someone runs the scanner.
orch-scan-*.json

# ───────────── OS / editor junk ─────────────
.DS_Store
Thumbs.db
~$*
*.swp
